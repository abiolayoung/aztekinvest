# Public browser-safe values. Never put secret keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for blockchain webhooks and the notification outbox.
# Never expose this value to client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical app URL used for auth email redirects.
APP_URL=http://localhost:3000

# Optional transactional email (Resend). Leave blank until a sender is approved.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Aztek Investment <support@example.com>

# Optional shared secret for /api/notifications/dispatch
CRON_SECRET=

# Optional custody or blockchain monitoring provider.
# Manual wallet deposits do not require a crypto provider.
# Deposits stay disabled until an administrator verifies a receiving wallet
# and turns deposits on in application settings. Do not invent wallet addresses.
CRYPTO_PROVIDER_API_KEY=
CRYPTO_PROVIDER_WEBHOOK_SECRET=
CRYPTO_PROVIDER_BASE_URL=

# Optional published contact details. Leave blank rather than inventing them.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Used only by scripts/apply-migrations.mjs. Never expose as NEXT_PUBLIC.
SUPABASE_DB_PASSWORD=
